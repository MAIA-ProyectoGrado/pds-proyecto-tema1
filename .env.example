# Variables de entorno del proyecto SCIF
# Copiar este archivo como .env y poner las claves propias.
# El .env no se sube a Git.

# Puerto del tablero cuando se usa docker compose
SCIF_PORT=8080

# La API usa el puerto 8000. Dentro de Docker es interno (no se publica
# ni se configura aqui). Sin Docker se arranca con: uvicorn src.api.main:app --port 8000

# Carpeta de los modelos (solo si se corre la API sin Docker)
SCIF_MODELS_DIR=./models

# Origenes permitidos por CORS
SCIF_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Servidor de MLflow para el entrenamiento
MLFLOW_TRACKING_URI=http://localhost:5000

# 1 = no guardar el modelo en MLflow, 0 = guardarlo
SCIF_SKIP_MODEL_LOGGING=0

# Credenciales de AWS para DVC y los scripts de infra.
# Cada persona pone las suyas, aqui van vacias.
# AWS_ACESS_KEY se escribe asi porque asi la lee scripts/awsenv.sh
AWS_ACESS_KEY=
AWS_SECRET_ACCESS_KEY=

# Region de AWS: us-east-1 (si hace falta, exportarla en la terminal)
