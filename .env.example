# Variables de entorno de SCIF.
#
# Copia este archivo como .env junto a docker-compose.yml y edita lo que necesites:
#   cp .env.example .env
# docker compose lo lee al arrancar. Una variable vacía toma el valor por defecto
# que aparece en el comentario (definido en src/api/config.py). Un valor inválido
# detiene el arranque de la API con un mensaje que nombra la variable.

# ── Despliegue ───────────────────────────────────────────────────────────────
# Puerto público del tablero (y de la API, bajo /api/). Defecto: 8080
SCIF_PORT=
# Procesos de uvicorn. Cada uno carga su propia copia de los modelos. Defecto: 1
SCIF_WORKERS=
# Carpeta de los modelos. En Docker es /models y no se cambia.
# Defecto sin Docker: <repo>/models
SCIF_MODELS_DIR=
# Prefijo con que se publica la API detrás de un proxy. En Docker es /api (nginx)
# y no se cambia. Defecto sin Docker: vacío
SCIF_ROOT_PATH=

# ── Modelos ──────────────────────────────────────────────────────────────────
# Modelo de /predict cuando la petición no indica uno: scibert | tfidf-logreg. Defecto: scibert
SCIF_DEFAULT_MODEL=
# Precargar el modelo por defecto y MiniLM al arrancar: true | false. Defecto: true
SCIF_WARMUP=
# Hilos de torch por proceso. Defecto: min(4, núcleos)
SCIF_TORCH_THREADS=
# Diferencia mínima entre las dos clases más probables para no marcar la
# predicción como ambigua, entre 0 y 1. Defecto: 0.10
SCIF_AMBIGUITY_THRESHOLD=

# ── Artículo citado y pasajes ────────────────────────────────────────────────
# Pasajes que devuelve /retrieve si la petición no indica top_k, entre 1 y 10. Defecto: 3
SCIF_TOP_K=
# Palabras máximas por pasaje del artículo citado. Defecto: 300
SCIF_CHUNK_WORDS=
# Artículos de arXiv procesados que se guardan en memoria (0 desactiva). Defecto: 32
SCIF_DOC_CACHE_SIZE=
# Tiempo máximo de cada consulta a arXiv, en segundos. Defecto: 40
SCIF_HTTP_TIMEOUT=
# Tamaño máximo del PDF que se descarga, en MB. Defecto: 25
SCIF_MAX_PDF_MB=
# Páginas del PDF que se leen. Defecto: 40
SCIF_MAX_PDF_PAGES=

# ── Uso controlado ───────────────────────────────────────────────────────────
# Caracteres máximos del contexto de cita. Defecto: 3000
SCIF_MAX_CONTEXT_CHARS=
# Caracteres máximos del texto pegado del artículo citado. Defecto: 200000
SCIF_MAX_CITED_TEXT_CHARS=
# Tamaño máximo de una petición, en KB (más grande: error 413). Defecto: 1024
SCIF_MAX_BODY_KB=
# Peticiones a /predict y /retrieve por minuto y por IP (más: error 429).
# 0 desactiva el límite. Defecto: 30
SCIF_RATE_LIMIT_PER_MIN=
# Orígenes permitidos por CORS, separados por comas. Solo importa si la API se
# expone sin nginx. Defecto: http://localhost:8080,http://127.0.0.1:8080
SCIF_ALLOWED_ORIGINS=

# ── Modelos de lenguaje en Amazon Bedrock (Nova Pro y Ministral 3 8B) ────────
# Ofrecerlos en el tablero y en /predict: true | false. Requiere credenciales de
# AWS con permiso bedrock:InvokeModel; en EC2 las da el rol de la instancia
# (infra/enable_bedrock.sh). Sin ellas, déjalo en false. Defecto: false
SCIF_LLM_ENABLED=
# Región de Bedrock. Defecto: us-east-2
SCIF_BEDROCK_REGION=
# Gasto máximo por día (UTC) en USD, sumando los dos modelos. Al llegar al tope
# responden 429 hasta las 00:00 UTC; 0 los bloquea. Defecto: 5
SCIF_LLM_DAILY_BUDGET_USD=
# Consultas por minuto y por IP a los modelos de lenguaje, además del límite
# general. 0 desactiva el límite. Defecto: 5
SCIF_LLM_RATE_LIMIT_PER_MIN=
# Tiempo máximo de respuesta de Bedrock, en segundos. Defecto: 30
SCIF_LLM_TIMEOUT=
# Archivo con el gasto acumulado del día. En Docker va en el volumen scif-state
# y no se cambia. Defecto sin Docker: var/llm_gasto.json
SCIF_LLM_SPEND_FILE=

# ── Solo para entrenamiento e infraestructura (la API no las lee) ────────────
# Servidor de MLflow de scripts/train.py. Defecto: file:./mlruns
MLFLOW_TRACKING_URI=
# Descargar modelos y datos no requiere credenciales (dvc pull -r publico). Para
# subir datos con DVC, las credenciales de AWS no van aquí: configúralas con
# `aws login` o `aws configure`.
