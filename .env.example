# PLANTILLA DE VARIABLES DE ENTORNO - SCIF (pds-proyecto-tema1)

# Entorno de Ejecución 
APP_ENV=production
LOG_LEVEL=INFO

# Puertos de Servicios (FastAPI y Tablero Dash) 
API_HOST=0.0.0.0
API_PORT=8000
DASH_HOST=0.0.0.0
DASH_PORT=8050
API_BASE_URL=http://localhost:8000

# Configuración de Modelos e Inferencia
MODEL_DIR=models/scibert_finetuned
FALLBACK_MODEL_PATH=models/tfidf_logreg.joblib
DEFAULT_MODEL=scibert
AMBIGUITY_THRESHOLD=0.10
MAX_SEQ_LENGTH=256

# Almacenamiento Remoto y Versionamiento (AWS S3 / DVC) 
AWS_REGION=us-east-1
AWS_S3_BUCKET=pds-proyecto-tema1-data
AWS_ACCESS_KEY_ID=tu_access_key_aqui
AWS_SECRET_ACCESS_KEY=tu_secret_key_aqui

# Seguimiento Experimental (MLflow) 
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=citation-intent-9classes